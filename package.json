{
  "name": "interstellar",
  "version": "1.0.0",
  "private": true,
  "description": "A map",
  "keywords": [
    "interstellar",
    "near",
    "earth",
    "objects",
    "planets",
    "orbit",
    "rotation",
    "stars",
    "star",
    "sun",
    "planet",
    "earth",
    "moon",
    "mercury",
    "venus",
    "mars",
    "tellus",
    "gaia",
    "jupiter",
    "saturn",
    "neptune",
    "pluto",
    "dwarf",
    "planets",
    "trajectory",
    "asteroids",
    "comets",
    "collision",
    "satellite",
    "satellites",
    "sky map",
    "nasa",
    "jpl",
    "esa"
  ],
  "homepage": "https://github.com/phun-ky/interstellar#readme",
  "bugs": {
    "url": "https://github.com/phun-ky/interstellar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/interstellar.git"
  },
  "license": "GPL-3.0",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist/*",
    "commit": "npx git-cz",
    "dev": "vite",
    "preview": "vite preview",
    "style:code": "npx putout src",
    "style:format": "eslint -c ./eslint.config.mjs src  --fix && ./node_modules/.bin/prettier --write ./eslint.config.mjs src",
    "style:lint": "eslint -c ./eslint.config.mjs src && ./node_modules/.bin/prettier --check src",
    "pretest:ci": "rm -rf coverage && mkdir -p coverage",
    "pretest:e2e": "rm -rf test-results && npm run build",
    "test": "npm run test:unit",
    "test:ci": "glob -c \"node --import tsx --import global-jsdom/register --test --no-warnings --experimental-test-coverage --test-reporter=cobertura --test-reporter-destination=coverage/cobertura-coverage.xml --test-reporter=spec --test-reporter-destination=stdout\" \"./src/**/__tests__/**/*.spec.[jt]s\"",
    "test:e2e": "npx playwright test",
    "test:unit": "glob -c \"node --import tsx --import global-jsdom/register --test --no-warnings\" \"./src/**/__tests__/**/*.spec.[jt]s\""
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "devDependencies": {
    "@phun-ky/eslint-config": "^0.1.10",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@types/node": "^22.13.1",
    "cobertura": "^1.0.1",
    "cssnano": "^7.0.6",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.2",
    "git-cz": "^4.9.0",
    "glob": "^14.0.2",
    "global-jsdom": "^26.0.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "postcss-cli": "^11.0.0",
    "prettier": "3.5.1",
    "putout": "^38.2.0",
    "stylus": "^0.64.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.6",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@interstellar-tools/constants": "^1.2.1",
    "@interstellar-tools/equations": "^1.12.0",
    "@interstellar-tools/temporal": "^1.2.0",
    "@interstellar-tools/types": "^1.12.0"
  }
}
