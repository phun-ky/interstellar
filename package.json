{
  "name": "interstellar",
  "version": "1.0.0",
  "private": true,
  "description": "A map",
  "keywords": [
    "interstellar",
    "near",
    "earth",
    "objects",
    "planets",
    "orbit",
    "rotation",
    "stars",
    "star",
    "sun",
    "planet",
    "earth",
    "moon",
    "mercury",
    "venus",
    "mars",
    "tellus",
    "gaia",
    "jupiter",
    "saturn",
    "neptune",
    "pluto",
    "dwarf",
    "planets",
    "trajectory",
    "asteroids",
    "comets",
    "collision",
    "satellite",
    "satellites",
    "sky map",
    "nasa",
    "jpl",
    "esa"
  ],
  "homepage": "https://github.com/phun-ky/site-interstellar#readme",
  "bugs": {
    "url": "https://github.com/phun-ky/site-interstellar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/site-interstellar.git"
  },
  "license": "GPL-3.0",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist/*",
    "commit": "npx git-cz",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:html": "html-validate dist/*.html",
    "prepare": "git config core.hooksPath .githooks || true",
    "pretest:e2e": "rm -rf test-results && npm run build",
    "preview": "vite preview",
    "test": "node --import tsx --test 'src/**/__tests__/**/*.spec.ts'",
    "test:coverage": "node --import tsx --enable-source-maps --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/__tests__/**' --test-coverage-lines=89 --test-coverage-branches=88 --test-coverage-functions=95 'src/**/__tests__/**/*.spec.ts'",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tests/tsconfig.json",
    "test:performance": "playwright test -c playwright.performance.config.mjs",
    "check:bestpractices": "node scripts/check-bestpractices.mjs",
    "bestpractices:url": "node scripts/bestpractices-url.mjs"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.1",
    "cssnano": "^7.0.6",
    "eslint": "^10.14.0",
    "eslint-config-phun-ky": "^2.0.10",
    "git-cz": "^4.9.0",
    "globals": "^17.14.0",
    "html-validate": "^11.17.0",
    "postcss": "^8.5.2",
    "postcss-cli": "^11.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.6",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@interstellar-tools/constants": "^1.2.1",
    "@interstellar-tools/equations": "^1.12.0",
    "@interstellar-tools/temporal": "^1.2.0",
    "@interstellar-tools/types": "^1.12.0"
  }
}
