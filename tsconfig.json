{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "./dts",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "src/types/global.d.ts"],
  "exclude": ["node_modules", "build", "dist", "tests/**", "scripts", "dts/**"]
}
