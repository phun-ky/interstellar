#!/bin/sh
# Adds a Developer Certificate of Origin sign-off to every commit message,
# unless the same sign-off is already there (for example from `git commit -s`).
# Enabled by `npm install`, through the `prepare` script:
#   git config core.hooksPath .githooks
git interpret-trailers --if-exists addIfDifferent --in-place \
  --trailer "Signed-off-by: $(git config user.name) <$(git config user.email)>" "$1"
